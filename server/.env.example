PORT=3000
HOST=0.0.0.0
CLIENT_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus
DATABASE_SSL=false
NAVIGATOR_ENABLED=false
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Установите 1 только за одним доверенным reverse proxy (например, Render).
TRUST_PROXY_HOPS=0
DEFAULT_GROUP_CODE=261-321
CAMPUS_TIME_ZONE=Europe/Moscow
ASSISTANT_MODE=verified-data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_REASONING_EFFORT=none
